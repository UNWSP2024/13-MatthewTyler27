import sqlite3

def main():
    
    connection = sqlite3.connect('phonebook.db')

    cursor = connection.cursor()
    
    add_entries_table(cursor)
    
    print("Phonebook Options:")
    print("1. Add an entry")
    print("2. Delete an entry")
    print("3. Display all entries")
    choice = input("Choose an option (1-3): ")

    if choice == '1':
        name = input("Enter name: ")
        phone = input("Enter phone number: ")
        add_entry(cursor, name, phone)
    elif choice == '2':
        name = input("Enter the name to delete: ")
        delete_entry(cursor, name)
    elif choice == '3':
        display_entries(cursor)
    else:
        print("Invalid option.")

    connection.commit()
    connection.close()


def add_entries_table(cur):
    cur.execute('DROP TABLE IF EXISTS Entries')

    cur.execute('''CREATE TABLE Entries (
                      name TEXT PRIMARY KEY,
                      phone INTEGER)''')

def add_entry(cur, name, phone):
    try:
        cur.execute('''INSERT INTO Entries (name, phone)
                       VALUES (?, ?)''', (name, phone))
        print(f'Added entry for {name}.')
    except sqlite3.IntegrityError:
        print(f'An entry for {name} already exists.')

def delete_entry(cur, name):
    cur.execute('DELETE FROM Entries WHERE name = ?', (name,))
    if cur.rowcount == 0:
        print(f'No entry found for {name}.')
    else:
        print(f'Entry for {name} deleted.')

def display_entries(cur):
    print('\nContents of phonebook.db/Entries table:')
    cur.execute('SELECT * FROM Entries')
    results = cur.fetchall()
    for row in results:
        print(f'{row[0]:20}{row[1]}')

if __name__ == '__main__':
    main()
